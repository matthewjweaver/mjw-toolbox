# Use PQ suites whenever possible, ed25519-only suites included for
# backwards compatibility.
Compression  yes
ControlMaster auto
ControlPath ~/.ssh/control-%r@%h:%p
ControlPersist 8h
ForwardAgent yes
ForwardX11  no
ForwardX11Trusted  no
HashKnownHosts yes
KeepAlive  yes
Protocol  2

Host *
  KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512,sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org
  PubkeyAuthentication yes
  HostKeyAlgorithms ssh-mldsa44-ed25519,ssh-mldsa44-ed25519-cert,ssh-ed25519,sk-ssh-ed25519@openssh.com
  Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com
  MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
